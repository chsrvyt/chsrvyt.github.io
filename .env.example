# ---------------------------------------------------------------------------
# Copy to .env.local. Never commit the real file — see .gitignore.
# Every variable here is SERVER-ONLY. None are prefixed NEXT_PUBLIC_, so none
# are ever inlined into the client bundle.
# ---------------------------------------------------------------------------

# Build-time only. Raises the GitHub ceiling from 60 to 5,000 requests/hour
# while `next build` reads the API. A fine-grained token with NO scopes is
# enough. In CI this is supplied automatically by GitHub Actions.
#
# It is never shipped to the browser: the client-side refresh in
# lib/github/browser.ts is deliberately unauthenticated, because any token in
# client code is a published token.
GITHUB_TOKEN=

# Canonical origin, used for metadata, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://chsrvyt.github.io
