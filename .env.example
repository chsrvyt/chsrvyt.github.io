# ---------------------------------------------------------------------------
# Copy to .env.local. Never commit the real file — see .gitignore.
# Every variable here is SERVER-ONLY. None are prefixed NEXT_PUBLIC_, so none
# are ever inlined into the client bundle.
# ---------------------------------------------------------------------------

# Optional but strongly recommended.
# Unauthenticated GitHub REST is capped at 60 requests/hour/IP; a fine-grained
# personal access token with NO scopes (public read only) raises that to 5,000.
GITHUB_TOKEN=

# Optional. Shared secret configured on the GitHub webhook.
# When unset, /api/github/webhook rejects every request (fail closed).
GITHUB_WEBHOOK_SECRET=

# Canonical origin, used for metadata, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://sarveshchonde.dev
